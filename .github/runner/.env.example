# Copy to .env (chmod 600) and fill in. Used by docker-compose.yml.
#
# GH_PAT mints a fresh just-in-time runner config on every container start,
# so the runner is ephemeral (one job per boot, auto-removed).
#
# PAT scope:
#   - Fine-grained: repo "Administration: Read & write" on the runner repo
#   - Classic:      the `repo` scope

GITHUB_URL=https://github.com/aster-rpc/aster-rpc-internal
GH_PAT=<your-personal-access-token>
