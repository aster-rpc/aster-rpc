<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RootNamespace>Aster</RootNamespace>
    <AssemblyName>Aster</AssemblyName>
    <OutputType>Library</OutputType>

    <!-- NuGet package metadata -->
    <PackageId>Aster</PackageId>
    <Authors>aster-rpc</Authors>
    <Description>Aster RPC .NET bindings for peer-to-peer networking</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/aster-rpc/aster-rpc-internal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Native library configuration. Override with -p:NativeLibraryPath=...;
       defaults to target/release, falling back to target/debug. -->
  <PropertyGroup>
    <AsterTargetDir>$(MSBuildThisFileDirectory)../../../../target</AsterTargetDir>
    <NativeLibraryPath Condition="'$(NativeLibraryPath)' == '' And (Exists('$(AsterTargetDir)/release/libaster_transport_ffi.dylib') Or Exists('$(AsterTargetDir)/release/libaster_transport_ffi.so') Or Exists('$(AsterTargetDir)/release/aster_transport_ffi.dll'))">$(AsterTargetDir)/release</NativeLibraryPath>
    <NativeLibraryPath Condition="'$(NativeLibraryPath)' == ''">$(AsterTargetDir)/debug</NativeLibraryPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeLibraryPath)/libaster_transport_ffi.dylib" Condition="Exists('$(NativeLibraryPath)/libaster_transport_ffi.dylib')" Link="libaster_transport_ffi.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NativeLibraryPath)/libaster_transport_ffi.so" Condition="Exists('$(NativeLibraryPath)/libaster_transport_ffi.so')" Link="libaster_transport_ffi.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NativeLibraryPath)/aster_transport_ffi.dll" Condition="Exists('$(NativeLibraryPath)/aster_transport_ffi.dll')" Link="aster_transport_ffi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)../../../../ffi/aster_ffi.h" Link="aster_ffi.h" />
    <None Include="$(MSBuildThisFileDirectory)../../CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aster.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.3.0" />
    <!-- ILogger bridge (O9): the abstractions only; the application brings its logging provider -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.9" />
    <!-- 1.7.6 wire format with the C# metadata-cache publication fix (FORY-CS-001).
         Resolve this exact fork package through NuGet.Config. -->
    <PackageReference Include="Apache.Fory" Version="[1.7.6-aster.1]" />
  </ItemGroup>

</Project>
